# --- Data -----------------------------------------------------------------
# SwitchLingua is a gated dataset: no corpus text or derived labels in git.
# Everything under data/ is ignored except the small result summaries in
# data/results/ (the consensus summaries stay local, as before).
data/*
!data/results/
data/results/consensus*.json

